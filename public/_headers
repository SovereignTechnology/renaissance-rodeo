# Applied by the static-asset layer. Requests that match a file in public/ are
# served directly and never invoke the Worker, so the headers set in
# src/index.js only cover API and 404 responses. The Content-Security-Policy
# line below and SECURITY_HEADERS in src/index.js must stay byte-identical —
# test/index.spec.js asserts it.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'

# There is no build step, so replaced images and fonts keep their names: bump
# the ?v= query on the changed file's references (every HTML file AND style.css)
# when one changes. The tree is on ?v=2 since 2026-10-14. README, "Replacing an asset".
/img/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# Staging only (README, "Staging"): the second Worker on staging.renaissance.rodeo serves this
# same file, so the rule is scoped by hostname and never reaches production. Keeps the copy
# under review out of search results; the canonical links already point at production.
https://staging.renaissance.rodeo/*
  X-Robots-Tag: noindex, nofollow
